<Window x:Class="AntStressMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AntStressMonitor"
        Width="150" Height="20"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        Background="#007ACC"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <!-- Drag handle: left-click drag moves the window -->
    <Grid MouseLeftButtonDown="Grid_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- BPM display -->
        <TextBlock x:Name="BpmText"
                   Grid.Column="0"
                   Text="-- BPM"
                   Foreground="White"
                   FontFamily="Segoe UI"
                   FontSize="9"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   Margin="4,0,0,0"
                   SnapsToDevicePixels="True"/>

        <!-- Time-in-Zone display -->
        <TextBlock x:Name="ZoneText"
                   Grid.Column="1"
                   Text="0:00"
                   Foreground="White"
                   FontFamily="Segoe UI"
                   FontSize="9"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   Margin="0,0,4,0"
                   SnapsToDevicePixels="True"/>
    </Grid>
</Window>

