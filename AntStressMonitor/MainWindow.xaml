<Window x:Class="AntStressMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AntStressMonitor"
        Width="200" Height="20"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        Background="#007ACC"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <!-- Drag handle: left-click drag moves the window -->
    <Grid MouseLeftButtonDown="Grid_MouseLeftButtonDown">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Show Graph" Click="ShowGraph_Click"/>
                <Separator/>
                <MenuItem x:Name="DeviceStatusMenuItem"
                          Header="Device: Searching…"
                          IsEnabled="False"
                          Foreground="#888"/>
                <MenuItem x:Name="LockDeviceMenuItem"
                          Header="Lock to Device"
                          Click="LockDevice_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="Exit_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>
        <Grid.ToolTip>
            <ToolTip x:Name="OverlayToolTip">
                <TextBlock x:Name="ToolTipText" Text="Device: Searching…"/>
            </ToolTip>
        </Grid.ToolTip>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- BPM display -->
        <TextBlock x:Name="BpmText"
                   Grid.Column="0"
                   Text="-- BPM"
                   Foreground="White"
                   FontFamily="Segoe UI"
                   FontSize="9"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   Margin="4,0,0,0"
                   SnapsToDevicePixels="True"/>

        <!-- Stress display (S:42 coloured by Garmin zone) -->
        <TextBlock x:Name="StressText"
                   Grid.Column="1"
                   Text="S:--"
                   Foreground="White"
                   FontFamily="Segoe UI"
                   FontSize="9"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Margin="4,0,4,0"
                   SnapsToDevicePixels="True"/>

        <!-- Time-in-Zone display -->
        <TextBlock x:Name="ZoneText"
                   Grid.Column="2"
                   Text="0:00"
                   Foreground="White"
                   FontFamily="Segoe UI"
                   FontSize="9"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   Margin="0,0,4,0"
                   SnapsToDevicePixels="True"/>
    </Grid>
</Window>

