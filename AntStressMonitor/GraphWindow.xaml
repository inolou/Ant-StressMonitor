<Window x:Class="AntStressMonitor.GraphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Heart Rate Graph"
        Width="640" Height="380" MinWidth="400" MinHeight="280"
        Background="#1A1A1A"
        Foreground="White"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Topmost="True"
        ShowInTaskbar="True">

    <Window.Resources>
        <!-- Range toggle-button style -->
        <Style x:Key="RangeButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3E3E3E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Top bar: device info + range selector ─────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical">
                <TextBlock x:Name="DeviceStatusText"
                           Text="Searching…"
                           Foreground="#888"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                <!-- BPM / Stress legend -->
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Rectangle Width="12" Height="3" Fill="#00C851"
                               VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <TextBlock Text="BPM"
                               Foreground="#888" FontFamily="Segoe UI" FontSize="9"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Rectangle Width="12" Height="3" Fill="#FF9900"
                               VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <TextBlock x:Name="StressLegendText"
                               Text="Stress"
                               Foreground="#FF9900" FontFamily="Segoe UI" FontSize="9"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <RadioButton x:Name="RbLive"   Content="Live"  IsChecked="True"
                             Style="{StaticResource RangeButtonStyle}"
                             Checked="OnRangeChanged"/>
                <RadioButton x:Name="Rb1h"     Content="1h"
                             Style="{StaticResource RangeButtonStyle}"
                             Checked="OnRangeChanged"/>
                <RadioButton x:Name="Rb4h"     Content="4h"
                             Style="{StaticResource RangeButtonStyle}"
                             Checked="OnRangeChanged"/>
                <RadioButton x:Name="Rb24h"    Content="24h"
                             Style="{StaticResource RangeButtonStyle}"
                             Checked="OnRangeChanged"/>
            </StackPanel>
        </Grid>

        <!-- ── Chart canvas ──────────────────────────────────────────── -->
        <Border Grid.Row="1"
                Background="#0D0D0D"
                BorderBrush="#333"
                BorderThickness="1">
            <Canvas x:Name="ChartCanvas"
                    ClipToBounds="True"
                    SizeChanged="ChartCanvas_SizeChanged"/>
        </Border>

        <!-- ── Status bar ─────────────────────────────────────────────── -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Text=""
                   Foreground="#666"
                   FontFamily="Segoe UI"
                   FontSize="10"
                   Margin="0,4,0,0"
                   HorizontalAlignment="Right"/>
    </Grid>
</Window>
